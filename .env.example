# The secrets file for the server: /srv/svelte-abc/.env (owner claude, chmod 600). Never commit the real one.
# Everything is optional: without a value, that feature is just off.

# Contact form email through Brevo (Kia's shared account; make an SMTP key named "svelte-abc").
SMTP_LOGIN=
SMTP_KEY=
# MAIL_FROM=ABC Company demo <svelte-abc@kiapmd.dev>
# CONTACT_TO_EMAIL=info@kiapmd.dev
# EMAILS_PER_DAY=10

# "Log in with GitHub" for the editor at /admin (a GitHub OAuth App; callback URL:
# https://svelte-abc.kiapmd.dev/api/cms-auth/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
